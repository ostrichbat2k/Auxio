<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:transitionGroup="true"
    tools:context=".settings.categories.UsbPipelineFragment">

    <org.oxycblt.auxio.ui.CoordinatorAppBarLayout
        android:id="@+id/usb_pipeline_appbar"
        style="@style/Widget.Auxio.AppBarLayout"
        app:liftOnScroll="true">

        <org.oxycblt.auxio.ui.AuxioToolbar
            android:id="@+id/usb_pipeline_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/ic_back_24"
            app:title="@string/set_usb_pipeline" />

    </org.oxycblt.auxio.ui.CoordinatorAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/usb_pipeline_contents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/spacing_medium"
            android:orientation="vertical">

            <!-- Stage 1: the file's own declared format, independent of route. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        style="@style/Widget.Auxio.TextView.Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="@string/set_usb_pipeline_stage_file" />

                    <TextView
                        android:id="@+id/usb_pipeline_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="24-bit / 96000Hz / 2ch" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 2: which sink RoutingAudioSink actually chose for this track. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        style="@style/Widget.Auxio.TextView.Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="@string/set_usb_pipeline_stage_route" />

                    <TextView
                        android:id="@+id/usb_pipeline_route"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="Direct -- bit-perfect straight to the DAC" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 3: UsbAudioOutput's ring buffer, live, see UsbPipelineStats. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        style="@style/Widget.Auxio.TextView.Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="@string/set_usb_pipeline_stage_buffer" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/usb_pipeline_buffer_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:max="100"
                        tools:progress="40" />

                    <TextView
                        android:id="@+id/usb_pipeline_buffer_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="2000ms / 5000ms buffered (40%)" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 4: what's actually going out over the wire right now. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        style="@style/Widget.Auxio.TextView.Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="@string/set_usb_pipeline_stage_transfer" />

                    <TextView
                        android:id="@+id/usb_pipeline_urbs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="124.6 URBs/sec" />

                    <TextView
                        android:id="@+id/usb_pipeline_underruns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        tools:text="0 underruns" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 5: what the device itself is actually configured for right now. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        style="@style/Widget.Auxio.TextView.Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="@string/set_usb_pipeline_stage_device" />

                    <TextView
                        android:id="@+id/usb_pipeline_device"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="FiiO Snowsky Tiny A -- 24-bit @ 96000Hz" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
